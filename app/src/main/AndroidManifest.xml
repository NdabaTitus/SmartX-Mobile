<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required for Google Sign-In and REST API calls -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartXMobile"
        tools:targetApi="31">

        <!-- LoginActivity is the LAUNCHER activity -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:label="Smart-X Login">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- MainActivity: post-login dashboard -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="Smart-X Dashboard" />

        <!-- SettingsActivity: user preferences -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Settings" />

        <!-- SensorsActivity: REST API data display -->
        <activity
            android:name=".SensorsActivity"
            android:exported="false"
            android:label="Sensors" />

        <!-- Firebase Cloud Messaging metadata (optional, for later) -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_launcher_foreground" />

    </application>

</manifest>