<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="#2D2D44"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/sensorId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sensor #1"
            android:textColor="#00D9A5"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sensorTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Temperature Sensor"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/sensorBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reading: 24.5°C"
            android:textColor="#A0A0B0"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>